# 复制为 .env 后修改（deploy.sh 首次部署会自动生成并填写密钥与管理员密码）
SECRET_KEY=please-change-me-use-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 时区（业务日期按此时区计算）
TZ=Asia/Shanghai

# SQLite 数据目录（容器内挂载卷）
DATABASE_URL=sqlite:///./data/zhixing.db

# CORS：同域部署可 *；多端跨域时写具体地址（逗号分隔）
CORS_ORIGINS=*

# 是否开放移动端自助注册（生产建议 false，由管理员开通账号）
ALLOW_REGISTER=false

# ---- 部署 ----
# 容器宿主监听地址与端口：
#   方案A（IP:端口直连）  HTTP_BIND=0.0.0.0
#   方案B（域名网关，推荐）HTTP_BIND=127.0.0.1，由宿主机 Nginx 按域名转发（deploy/nginx.conf）
HTTP_BIND=127.0.0.1
HTTP_PORT=8081
# 对外域名（仅用于 deploy.sh 汇总提示；网关模式必须配置真实域名）
DOMAIN=

# ---- 备份（deploy/backup.sh） ----
BACKUP_DIR=/opt/backups
BACKUP_RETENTION_DAYS=14

# ---- 知识框架（可选：本机 Obsidian 目录；生产留空则走 data/knowledge + 管理端上传） ----
KNOWLEDGE_KB_DIR=
