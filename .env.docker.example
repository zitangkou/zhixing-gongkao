# 复制为 .env 后修改
SECRET_KEY=please-change-me-use-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 时区（业务日期按此时区计算，docker-compose 已默认 Asia/Shanghai）
TZ=Asia/Shanghai

# SQLite 数据目录（容器内挂载卷）
DATABASE_URL=sqlite:///./data/zhixing.db

# 无域名时用 * 允许 IP 访问；生产有域名后改为具体地址
CORS_ORIGINS=*

# 是否开放移动端自助注册（生产建议 false）
ALLOW_REGISTER=false

# 爬虫（暂关闭）
CRAWL_ENABLED=false
# CRAWL_CRON_HOUR=6
# CRAWL_CRON_MINUTE=0
