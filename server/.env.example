# 数据库（默认 SQLite，生产可换 PostgreSQL）
DATABASE_URL=sqlite:///./data/zhengkao.db

# JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 爬虫
CRAWL_ENABLED=false
CRAWL_CRON_HOUR=6
CRAWL_CRON_MINUTE=0

# CORS（H5 开发用 localhost；Docker 同域部署可设为 *）
CORS_ORIGINS=http://localhost:10086,http://localhost:10087

# 默认管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# AI 出题（DeepSeek OpenAI 兼容接口）
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=120

# 语音识别（默认 none=前端免费 Web Speech；需要更准时再开云）
# ASR_PROVIDER=none|aliyun|tencent
ASR_PROVIDER=none
# 云配置齐全后是否优先云识别（false=仍优先免费浏览器）
ASR_PREFER_CLOUD=false
ALIYUN_ASR_APPKEY=
ALIYUN_ASR_TOKEN=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_APP_ID=
