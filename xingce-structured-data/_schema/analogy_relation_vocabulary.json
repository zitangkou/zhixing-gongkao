{
  "version": "v1",
  "description": "类比推理概念关系词库 — 10种关系类型，每种含若干词对示例，用于程序校验",
  "relation_types": {
    "种属关系": {
      "description": "A是B的一种（is-a），A是小概念，B是大概念",
      "direction": "小概念:大概念",
      "examples": [
        {"a": "苹果", "b": "水果"},
        {"a": "汽车", "b": "交通工具"},
        {"a": "玫瑰", "b": "花"},
        {"a": "老虎", "b": "哺乳动物"},
        {"a": "钢琴", "b": "乐器"},
        {"a": "正方形", "b": "四边形"},
        {"a": "小麦", "b": "粮食"},
        {"a": "冰箱", "b": "家电"}
      ]
    },
    "组成关系": {
      "description": "A是B的组成部分（part-of），A是部分，B是整体",
      "direction": "部分:整体",
      "examples": [
        {"a": "轮胎", "b": "汽车"},
        {"a": "树叶", "b": "树"},
        {"a": "键盘", "b": "电脑"},
        {"a": "发动机", "b": "飞机"},
        {"a": "窗户", "b": "房屋"},
        {"a": "笔尖", "b": "钢笔"},
        {"a": "果肉", "b": "苹果"},
        {"a": "屏幕", "b": "手机"}
      ]
    },
    "因果关系": {
      "description": "A导致B（cause-effect），A是原因，B是结果",
      "direction": "原因:结果",
      "examples": [
        {"a": "下雨", "b": "地湿"},
        {"a": "努力", "b": "成功"},
        {"a": "生病", "b": "吃药"},
        {"a": "违章", "b": "罚款"},
        {"a": "熬夜", "b": "疲劳"},
        {"a": "施肥", "b": "丰收"},
        {"a": "堵车", "b": "迟到"},
        {"a": "运动", "b": "健康"}
      ]
    },
    "功能关系": {
      "description": "A的功能是B（function），A是物品，B是用途/动作",
      "direction": "物品:功能",
      "examples": [
        {"a": "剪刀", "b": "裁剪"},
        {"a": "手机", "b": "通讯"},
        {"a": "雨伞", "b": "遮雨"},
        {"a": "冰箱", "b": "冷藏"},
        {"a": "毛笔", "b": "书写"},
        {"a": "眼镜", "b": "矫正视力"},
        {"a": "灭火器", "b": "灭火"},
        {"a": "闹钟", "b": "提醒"}
      ]
    },
    "职业与工具": {
      "description": "A是职业，B是该职业常用工具（profession-tool）",
      "direction": "职业:工具",
      "examples": [
        {"a": "医生", "b": "手术刀"},
        {"a": "教师", "b": "粉笔"},
        {"a": "画家", "b": "画笔"},
        {"a": "厨师", "b": "炒锅"},
        {"a": "木匠", "b": "锯子"},
        {"a": "消防员", "b": "灭火器"},
        {"a": "摄影师", "b": "相机"},
        {"a": "农民", "b": "锄头"}
      ]
    },
    "材料与成品": {
      "description": "A是制作B的原材料（material-product），A是材料，B是成品",
      "direction": "材料:成品",
      "examples": [
        {"a": "木材", "b": "桌子"},
        {"a": "棉花", "b": "衣服"},
        {"a": "面粉", "b": "面包"},
        {"a": "钢铁", "b": "汽车"},
        {"a": "黏土", "b": "陶瓷"},
        {"a": "蚕丝", "b": "丝绸"},
        {"a": "石油", "b": "塑料"},
        {"a": "竹子", "b": "筷子"}
      ]
    },
    "近义关系": {
      "description": "A和B意思相近（synonym）",
      "direction": "词:近义词",
      "examples": [
        {"a": "高兴", "b": "快乐"},
        {"a": "美丽", "b": "漂亮"},
        {"a": "聪明", "b": "机智"},
        {"a": "愤怒", "b": "恼怒"},
        {"a": "恐惧", "b": "害怕"},
        {"a": "疲惫", "b": "疲倦"},
        {"a": "宝贵", "b": "珍贵"},
        {"a": "广阔", "b": "辽阔"}
      ]
    },
    "反义关系": {
      "description": "A和B意思相反（antonym）",
      "direction": "词:反义词",
      "examples": [
        {"a": "高兴", "b": "难过"},
        {"a": "光明", "b": "黑暗"},
        {"a": "勇敢", "b": "怯懦"},
        {"a": "勤劳", "b": "懒惰"},
        {"a": "节约", "b": "浪费"},
        {"a": "谦虚", "b": "骄傲"},
        {"a": "复杂", "b": "简单"},
        {"a": "抽象", "b": "具体"}
      ]
    },
    "对应关系": {
      "description": "A和B有特定的对应/关联（correspondence），如节日与人物、作品与作者等",
      "direction": "事物:对应事物",
      "examples": [
        {"a": "七夕", "b": "织女"},
        {"a": "端午", "b": "屈原"},
        {"a": "《红楼梦》", "b": "曹雪芹"},
        {"a": "《西游记》", "b": "吴承恩"},
        {"a": "中秋节", "b": "月饼"},
        {"a": "元宵节", "b": "汤圆"},
        {"a": "医生", "b": "医院"},
        {"a": "教师", "b": "学校"}
      ]
    },
    "条件关系": {
      "description": "A是B的必要条件（condition），没有A就没有B",
      "direction": "条件:结果",
      "examples": [
        {"a": "水", "b": "生存"},
        {"a": "氧气", "b": "燃烧"},
        {"a": "阳光", "b": "光合作用"},
        {"a": "种子", "b": "发芽"},
        {"a": "考试", "b": "录取"},
        {"a": "报名", "b": "参赛"},
        {"a": "买票", "b": "乘车"},
        {"a": "地基", "b": "高楼"}
      ]
    }
  }
}
