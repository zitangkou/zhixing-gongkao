  "materials": {
    "m58_62": {
      "title": "2021年第一季度市场监管部门食品安全监督抽检情况（58-62题共用）",
      "content": "2021年第一季度市场监管部门食品安全监督抽检情况表（部分类别）：粮食加工品抽检量、不合格量；食用油、油脂及其制品；调味品；肉制品；乳制品；饮料；方便食品；饼干；罐头；冷冻饮品；速冻食品；薯类和膨化食品；糖果制品；茶叶及相关制品；酒类；蔬菜制品；水果制品；炒货食品及坚果制品；蛋制品；可可及焙烤咖啡产品；食糖；水产制品；糕点；豆制品；蜂产品；保健食品；特殊医学用途配方食品；婴幼儿配方食品；餐饮食品；食品添加剂等。各列含抽检量（批次）和不合格量（批次）。",
      "source_ref": {
        "file": "20224970.pdf",
        "page": 57
      },
      "note": "表格数据已转文本，具体数值见原图"
    },
    "m63_67": {
      "title": "2012-2020年中国IC封装市场规模（63-67题共用）",
      "content": "2012-2020年中国IC封装市场规模柱状图（亿元）及先进封装占比折线图。各年市场规模：2012年约1080亿、2013年约1180亿、2014年约1290亿、2015年约1380亿、2016年约1560亿、2017年约1890亿、2018年约2160亿、2019年约2350亿、2020年约2480亿。先进封装占比从2012年约3%逐年上升至2020年约13%。",
      "source_ref": {
        "file": "20224970.pdf",
        "page": 59
      },
      "note": "图表数据已转文本，具体数值见原图"
    }
  }
